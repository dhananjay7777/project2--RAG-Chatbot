# Environment template — copy to .env (never commit .env)

# LLM — Groq (Phases 4–5). Get a key at https://console.groq.com/
# Required for factual RAG answers (retrieve → Groq). Optional Tier-2 routing too.
# Without this key, factual questions return no-answer (no raw scrape dump).
GROQ_API_KEY=
# Optional overrides (defaults come from config.yaml)
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIER2_MODEL=llama-3.1-8b-instant

# App (local)
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# Phase 10 — Railway API
# CORS_ORIGINS=https://your-app.vercel.app
# MF_RATE_LIMIT_PER_HOUR=30
# MF_HEALTH_STRICT=1

# Phase 10 — Vercel Next.js UI / local Streamlit → remote API
# NEXT_PUBLIC_MF_API_URL=https://your-service.up.railway.app
# MF_API_URL=https://your-service.up.railway.app

# Safety: never put real PAN/Aadhaar/account samples here.
